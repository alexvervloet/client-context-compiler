{
  "name": "client-context-compiler",
  "version": "0.1.0",
  "private": true,
  "description": "Compiles a wealth-management agent's context window from CRM, email, and calendar records, one client at a time.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='evals/**' --test-coverage-lines=88 --test-coverage-branches=85 --test-coverage-functions=80 tests/*.test.ts",
    "ccc": "node --experimental-strip-types src/cli.ts",
    "evals": "node --experimental-strip-types evals/run.ts",
    "measure": "node --experimental-strip-types evals/measure.ts",
    "bench": "node --experimental-strip-types evals/bench.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts"
}
